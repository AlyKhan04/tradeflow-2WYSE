<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

  <changeSet id="014-add-instrument-isin-if-missing" author="copilot">
    <preConditions onFail="MARK_RAN">
      <tableExists tableName="instruments"/>
      <not>
        <columnExists tableName="instruments" columnName="isin"/>
      </not>
    </preConditions>
    <addColumn tableName="instruments">
      <column name="isin" type="VARCHAR(12)"/>
    </addColumn>
    <rollback>
      <dropColumn tableName="instruments" columnName="isin"/>
    </rollback>
  </changeSet>
</databaseChangeLog>
